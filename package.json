{
  "name": "x402seek-web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Reviewer preview for x402Seek — decision-grade discovery for autonomous x402 payments on Stellar. Semantic ranking with abstention over a frozen evidence catalog, plus a read-only live view of the hosted Stellar testnet facilitator. Not a facilitator, no wallet, testnet only.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": ["onnxruntime-node", "esbuild"]
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build:snapshot": "tsx scripts/build-snapshot.mts",
    "verify:vendor": "tsx scripts/verify-vendor.mts",
    "audit:licenses": "tsx scripts/audit-licenses.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "fastify": "5.11.3",
    "onnxruntime-node": "1.24.3"
  },
  "devDependencies": {
    "@types/node": "22.13.4",
    "tsx": "4.21.0",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
